NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only PostgreSQL connections from the Supabase Connect dialog.
# Use a pooled connection for Vercel runtime traffic.
DATABASE_URL=
# Keep runtime pools small on Vercel; increase only from measured provider limits.
DATABASE_POOL_MAX=1
# Use `disable` only for an explicitly local non-SSL PostgreSQL server.
DATABASE_SSL=require
# Use a direct or otherwise migration-approved connection for migrations.
DIRECT_DATABASE_URL=
# Dedicated disposable PostgreSQL database used only by integration tests.
TEST_DATABASE_URL=
# Set to disable only for an explicitly local non-SSL PostgreSQL test server.
TEST_DATABASE_SSL=require

# local, test, demo, review, or production
RINTARA_ENV=local
# Seed requires an explicit opt-in and always refuses production.
RINTARA_ALLOW_SEED=false
# Controlled production migration jobs must opt in explicitly.
RINTARA_ALLOW_PRODUCTION_MIGRATION=false

# Server-only secret used later to protect low-entropy check-in codes.
CHECK_IN_CODE_PEPPER=
